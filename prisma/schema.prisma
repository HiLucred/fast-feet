generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderState {
  PENDING
  PICKEDUP
  DELIVERED
}

enum UserRole {
  ADMIN
  COURIER
}

model Order {
  id           String     @unique @default(uuid())
  recipientId  String     @map("recipient_id")
  courierId    String?    @map("courier_id")
  state        OrderState
  pickedUpDate DateTime?  @map("picked_up_date")
  deliveryDate DateTime?  @map("delivery_date")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime?  @updatedAt() @map("updated_at")

  recipient Recipient @relation(fields: [recipientId], references: [id])
  courier   Courier?  @relation(fields: [courierId], references: [id])

  @@map("orders")
}

model Courier {
  id       String   @unique @default(uuid())
  name     String
  cpf      String   @unique
  password String
  role     UserRole @default(COURIER)

  Order Order[]

  @@map("couriers")
}

model Recipient {
  id           String @unique @default(uuid())
  name         String
  phoneNumber  Int    @unique @map("phone_number")
  zipCode      String @unique @map("zip_code")
  neighborhood String
  street       String
  number       String
  city         String
  state        String

  Order Order[]

  @@map("recipients")
}

model Adm {
  id       String   @unique @default(uuid())
  name     String
  email    String
  password String
  role     UserRole @default(ADMIN)

  @@map("adms")
}
